[node name="Middle" type="Button" parent="Content/Preview"]
layout_mode = 2
text = "Переход"

[node name="Expanded" type="Button" parent="Content/Preview"]
layout_mode = 2
text = "Город"

[node name="Detail" type="HSlider" parent="Content/Preview"]
custom_minimum_size = Vector2(180, 28)
layout_mode = 2
max_value = 1.0
step = 0.01
value = 1.0
tooltip_text = "Доля раскрытия города: от 0 до 100%. Масштаб рабочей области Godot независим."

[node name="Value" type="Label" parent="Content/Preview"]
layout_mode = 2

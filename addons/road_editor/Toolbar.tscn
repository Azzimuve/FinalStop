[gd_scene format=3]

[node name="RoadEditor" type="PanelContainer"]

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="MapTools" type="HFlowContainer" parent="Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Content/MapTools"]
layout_mode = 2
text = "Карта:"

[node name="AddCity" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Добавить город"
tooltip_text = "Создать чистый город с одной точкой въезда и разместить его в мире."

[node name="EditCity" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Редактировать город"

[node name="AddEntrance" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Добавить въезд"

[node name="Connect" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Соединить"
tooltip_text = "Выберите два въезда или дорожных узла. Затем настройте изгибы в режиме «Форма»."

[node name="AddPlace" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Добавить точку интереса"
tooltip_text = "Выберите один дорожный узел в сцене города. Новый объект появится на нём; назначение выбирается в Inspector."

[node name="AddCheckpoint" type="Button" parent="Content/MapTools"]
layout_mode = 2
text = "Поставить блокпост"
tooltip_text = "Нажмите и щёлкните в нужном месте на трассе или городской улице. Стрелка показывает направление въезда."

[node name="Preview" type="HFlowContainer" parent="Content"]
layout_mode = 2

[node name="Enabled" type="CheckButton" parent="Content/Preview"]
layout_mode = 2
